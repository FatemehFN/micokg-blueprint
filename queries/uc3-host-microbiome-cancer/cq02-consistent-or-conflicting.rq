# UC3-CQ02: For taxa associated with colorectal cancer, are the reported directions
# consistent across studies, conflicting, or based on a single study?
#
# This is the question that plain subject-predicate-object edges cannot answer:
# conflicting findings only survive because each claim is its own node.
#
# Parameter: ?queryDisease (default MONDO:0005575 colorectal cancer)
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dct: <http://purl.org/dc/terms/>
PREFIX obo: <http://purl.obolibrary.org/obo/>
PREFIX micokg: <https://w3id.org/micokg/>

SELECT ?taxon ?taxonLabel
       (COUNT(DISTINCT ?study) AS ?nStudies)
       (GROUP_CONCAT(DISTINCT ?direction; separator="|") AS ?directions)
       (IF(COUNT(DISTINCT ?direction) > 1, "conflicting",
           IF(COUNT(DISTINCT ?study) > 1, "consistent", "single study")) AS ?status)
WHERE {
  VALUES ?queryDisease { obo:MONDO_0005575 }

  ?association a micokg:TaxonDiseaseAssociation ;
               rdf:subject ?taxon ;
               rdf:object ?disease ;
               micokg:direction ?direction ;
               dct:source ?study .
  ?disease (skos:exactMatch|^skos:exactMatch)?/rdfs:subClassOf* ?queryDisease .
  FILTER NOT EXISTS { ?association micokg:negated true }

  OPTIONAL { ?taxon rdfs:label ?taxonLabel }
}
GROUP BY ?taxon ?taxonLabel
ORDER BY ?taxonLabel
