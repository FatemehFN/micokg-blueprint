# UC1-CQ01: Which biological processes (GO) are detected in air samples, and in
# how many samples per local environmental setting (e.g. outdoor vs building vs hospital)?
#
# Parameter: ?medium (default ENVO:00002005 air; subclasses of air also match)
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX obo: <http://purl.obolibrary.org/obo/>
PREFIX sosa: <http://www.w3.org/ns/sosa/>
PREFIX sio: <http://semanticscience.org/resource/>
PREFIX mixs: <https://w3id.org/mixs/>
PREFIX micokg: <https://w3id.org/micokg/>

SELECT ?process ?processLabel ?localScale ?localScaleLabel (COUNT(DISTINCT ?sample) AS ?nSamples)
WHERE {
  VALUES ?medium { obo:ENVO_00002005 }

  ?sample a sosa:Sample ;
          mixs:0000014 ?sampleMedium ;
          mixs:0000013 ?localScale .
  ?sampleMedium rdfs:subClassOf* ?medium .

  ?observation sosa:hasFeatureOfInterest ?sample ;
               sio:SIO_000332 ?gene ;
               sosa:hasSimpleResult ?value .
  FILTER (?value > 0)

  ?gene a micokg:FunctionalGene ;
        obo:RO_0000085 ?process .
  ?process rdfs:subClassOf* obo:GO_0008150 .   # biological_process

  OPTIONAL { ?process rdfs:label ?processLabel }
  OPTIONAL { ?localScale rdfs:label ?localScaleLabel }
}
GROUP BY ?process ?processLabel ?localScale ?localScaleLabel
ORDER BY ?processLabel ?localScaleLabel
